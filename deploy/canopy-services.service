[Unit]
Description=Canopy read-only user-service observer
After=user@1000.service
Wants=user@1000.service

[Service]
Type=simple
User=ubuntu
Group=canopy
WorkingDirectory=/opt/canopy/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=CANOPY_SERVICES_FILE=/run/canopy-services/services.json
ExecStart=/opt/canopy/venv/bin/python -m backend.services_probe
RuntimeDirectory=canopy-services
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/run/user/1000/bus
ReadWritePaths=/run/canopy-services
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
MemoryMax=96M
TasksMax=16

[Install]
WantedBy=multi-user.target
